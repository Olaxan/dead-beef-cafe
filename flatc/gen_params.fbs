include "name_pool.fbs";

namespace DBC.World;

table GenHost {
	hostName:string;
	hostTags:string;
}

table GenModule {
  moduleName:string;
  moduleTags:[string];
  minInstances:uint = null;
  maxInstances:uint = null;
  minHosts:uint = null;
  maxHosts:uint = null;
  networkPrefix:uint = null;
  customHosts:[GenHost];
  children:[GenModule];
}

table GenParams {
  modules:[GenModule];
}

root_type GenParams;
